# Copy this file to .env and adjust as needed:
#   cp .env.example .env

# Base URL of the backend API (see ../backend/.env.example to run it locally).
VITE_API_BASE_URL=http://localhost:3000

# Payment gateway sandbox API base URL. Card tokenization is called directly
# from the browser to this URL with the PUBLIC key returned by
# GET /checkout/config, so raw card data never transits through our own
# backend. Get the real value from your gateway provider's sandbox docs.
VITE_GATEWAY_API_URL=https://api-sandbox.example.dev/v1
