# Database
DATABASE_URL=postgresql://user:password@localhost:5432/checkout_store
NODE_ENV=development

# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Payment gateway (get these from your provider's sandbox dashboard)
GATEWAY_BASE_URL=https://api-sandbox.example.dev/v1
GATEWAY_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx
GATEWAY_PRIVATE_KEY=prv_test_xxxxxxxxxxxxxxxxxxxxxxxx
GATEWAY_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxxxxxxxxxx
GATEWAY_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxxxxxxxxxx

# Store fees (in cents, in your local currency)
BASE_FEE_IN_CENTS=300000
DELIVERY_FEE_IN_CENTS=500000